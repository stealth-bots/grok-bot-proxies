# Copy to .env.local for `vercel dev`. Never commit .env.local.
# Shape only — replace with your own values.

# Slack hop (/)
CURSOR_WEBHOOK_URL=https://api2.cursor.sh/automations/webhook/<uuid>
CURSOR_WEBHOOK_KEY=crsr_...
# SLACK_SIGNING_SECRET=

# Linear hop (/linear) — different Cursor routine from Slack
LINEAR_CURSOR_WEBHOOK_URL=https://api2.cursor.sh/automations/webhook/<uuid>
LINEAR_CURSOR_WEBHOOK_KEY=crsr_...
# Required. Without it, POST /linear returns 503 and does not forward.
LINEAR_WEBHOOK_SECRET=
